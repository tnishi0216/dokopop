<Window x:Class="amsocr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:amsocr"
        mc:Ignorable="d"
        Title="Auto MSOCR" Height="450" Width="800">
    <!-- 右クリック用コンテキストメニューを追加 -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="miCapturePage" Header="Capture Page" IsCheckable="True" />
            <MenuItem x:Name="miUseDefLang" Header="Use Default Language" IsCheckable="True" />
            <Separator />
            <MenuItem x:Name="miDebugMode" Header="Debug Mode" IsCheckable="True" />
        </ContextMenu>
    </Window.ContextMenu>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="54*"/>
            <ColumnDefinition Width="91*"/>
            <ColumnDefinition Width="655*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="66" />
            <RowDefinition Height="39" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <!--  ヘッダー  -->
        <Label Name="lbPoint" Content="(Point)" HorizontalAlignment="Left" VerticalAlignment="Top" Width="60" Height="25" Margin="48,0,0,0" Grid.Column="1" Grid.ColumnSpan="2"/>
        <Label Name="lbStatus" Content="(Status)" HorizontalAlignment="Center" VerticalAlignment="Top" Width="611" Height="25" Grid.Column="2"/>
        <TextBox x:Name="tbInfo"
                 Text="(Information)"
           IsReadOnly="True"
           AcceptsReturn="True"
           TextWrapping="Wrap"
           VerticalScrollBarVisibility="Auto"
           Margin="48,25,6,0"
           FontFamily="Consolas"
           FontSize="12" Grid.Column="1" Grid.ColumnSpan="2"/>
        <Label
            x:Name="lbPath"
            Grid.Row="1"
            Width="92"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Right"
            Content="ファイルパス：" Height="26" Grid.ColumnSpan="2" />
        <TextBox
            x:Name="txtPath"
            Grid.Row="1"
            Margin="48,0,183,0"
            VerticalAlignment="Center" Height="18" Grid.Column="1" Grid.ColumnSpan="2"
            />
        <Button
            Name="btnPath"
            Grid.Row="1"
            Width="70"
            Margin="485,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Click="btnPath_Click"
            Content="参照..."
            FontSize="12" Height="20" Grid.Column="2"
            />
        <Button
            Name="btnOcr"
            Grid.Row="1"
            Width="85"
            Margin="560,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Click="btnOcr_Click"
            Content="OCR実行"
            FontSize="12" Height="20" Grid.Column="2" />
        <Image
            x:Name="ImgTarget"
            Grid.Row="2"
            Margin="10,10,10,100" Grid.ColumnSpan="3" />
        <TextBox
            Name="txtOcrResult"
            Grid.Row="2"
            Margin="10,238,10,0"
            VerticalAlignment="Top"
            
            AcceptsReturn="True"
            IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignOutlinedTextBoxEnabledComboBox}"
            
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" Height="81" Grid.ColumnSpan="3" />
    </Grid>
</Window>
